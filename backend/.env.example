# KueryCore AI Backend Configuration Template

# Runtime environment. Set to "development" for local dev to auto-generate a
# random JWT secret; leave unset (defaults to "production") to REQUIRE
# JWT_SECRET_KEY to be explicitly set (startup fails loudly otherwise).
ENVIRONMENT=development

# Async PostgreSQL Connection (used by FastAPI asyncpg engine)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Sync PostgreSQL Connection (used by Alembic migrations)
DATABASE_URL_SYNC=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Google Gemini API Key — embeddings + vector search only (from https://aistudio.google.com/)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Groq Cloud API Key — LLM chat generation + vision OCR (from https://console.groq.com/)
GROQ_API_KEY=your_actual_groq_api_key_here

# Generative Model (Groq model id)
GENERATIVE_MODEL=llama-3.1-8b-instant

# JWT Security
JWT_SECRET_KEY=your_random_jwt_secret_key_here

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://*.vercel.app"]

# Jules REST API Key (from https://jules.google.com/settings#api)
JULES_API_KEY=your_actual_jules_api_key_here
