# DocuMind AI — Environment Variables
# Copy this to .env and fill in your values.

# Database
DATABASE_URL=postgresql+asyncpg://documind:documind_dev@localhost:5435/documind
DATABASE_URL_SYNC=postgresql://documind:documind_dev@localhost:5435/documind

# OmniRoute / LLM
# OMNIROUTE_BASE_URL=http://localhost:20128
GOOGLE_API_KEY=AQ.Ab8RN6IanBMR2u4D7JTs2tyMRLoqngdCMQXe5E7Z5Ki_AJ8d-Q
OMNIROUTE_MODEL=auto
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GENERATIVE_MODEL=gemini-flash-latest

# RAG Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=200
TOP_K=5
SIMILARITY_THRESHOLD=0.3

# Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# CORS (comma-separated if multiple)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Debug
DEBUG=true
